# Conexión a Neon (Vercel la carga sola si agregás Neon desde Storage)
DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require
# Cualquier texto largo y secreto: firma las sesiones de login
AUTH_SECRET=cambiame-por-un-texto-largo
# Playlist del gimnasio en Spotify (opcional)
NEXT_PUBLIC_SPOTIFY_PLAYLIST=https://open.spotify.com/search/workout
# Opcional: código que piden al crear cuenta (si está vacío, el registro es libre)
GYM_CODE=
# Opcional: ingreso con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=https://gymmontes.vercel.app
# Dueña: este email entra al panel /admin y recibe los avisos de pedidos
OWNER_EMAIL=loli@rebltech.com
# OWNER_PASSWORD=  # opcional: crea o resetea la cuenta de la dueña en el próximo deploy
# Opcional: aviso por email de cada pedido (cuenta gratis en resend.com)
RESEND_API_KEY=
EMAIL_FROM=GYM MONTES <onboarding@resend.dev>
# Opcional: WhatsApp del gimnasio, con código de país y sin espacios (ej. 59899123456)
GYM_WHATSAPP=
